
reaction(out(line(X0,Y0,X1,Y1)),(
    in_r(line(X0,Y0,X1,Y1)),
    out_r(collecting),
    out_r(check_subscribers(line(X0,Y0,X1,Y1))))).

%

reaction(out_r(check_subscribers(Info)),(
    rd_r(collecting),
    in_r(subscription(Template,Dest)),
    out_r(bak(subscription(Template,Dest))),
    out_r(match(Info,Template,Dest)),
    out_r(check_subscribers(Info)))).

reaction(out_r(check_subscribers(_)),(
    no_r(subscription(_,_)),
    in_r(collecting),
    out_r(restore_subscribers))).

reaction(out_r(check_subscribers(_)),(
    in_r(check_subscribers(_)))).

%

reaction(out_r(match(Info,Template,Dest)),(
    current_tuple(match(X,X,_)),
    out_tc(Dest,Info))).

reaction(out_r(match(_,_,_)),(
    in_r(match(_,_,_)))).

% 

reaction(out_r(restore_subscribers),(
    in_r(bak(subscription(Template,Dest))),
    out_r(subscription(Template,Dest)),
    out_r(restore_subscribers))).

reaction(out_r(restore_subscribers),(
    in_r(restore_subscribers))).



