% -----------------------------------------------


%
% sending msgs
%

%
% if a registered user sends a msg,
% accept and broadcast the msg
%
reaction(out(msg(Name,Msg)),(
	in_r(msg(Name,Msg)),
        rd_r(user(Name,_)),
        out_r(user_list([])),
        current_time(T),
	out_r(multicast(Name,Msg,T)))).

%
% generate a msg for each registered user
%
reaction(out_r(multicast(Who,Msg,When)),(
	in_r(multicast(Who,Msg,When)),
        in_r(user(Name,TupleCentre)),
        in_r(user_list(L)),
        out_r(user_list([user(Name,TupleCentre)|L])),
        out_tc(TupleCentre, msg(Who,Msg,When)),
        out_r(multicast(Who,Msg,When)))).

reaction(out_r(multicast(Who,Msg,When)),(
	in_r(multicast(Who,Msg,When)),
        no_r(user(_,_)),
        in_r(user_list(L)),
        out_r(out_list(L)),
	out_r(multicast_end(Who,Msg,When)))).

%-----------------------------------------------------------------------------

%
% helper reactions
%

reaction(out_r(out_list([])),(
	in_r(out_list([])))).

reaction(out_r(out_list([X|Rest])),(
	in_r(out_list([X|Rest])),
	out_r(X),
	out_r(out_list(Rest)))).



