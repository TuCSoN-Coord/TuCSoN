%
% to join:      inp(join(+Name,+MyTupleCentre))
% to leave:     out(leave(+Name))
% to send msg:  out(msg(+Name,+Msg))
% to read msg:  MyTupleCentre ? in(msg(Who,What,When))

%
% joining the chat room
%

%
% accept a new user only if 
% no other user are registered with the same Name
%
reaction(inp(join(Name,UserTC)),(
	pre,
        no_r(user(Name,_)),
        out_r(user(Name,UserTC)),
        out_r(join(Name,UserTC)))).

%
% leaving the chat room
%

%
% reaction #2
%
% a registered user ask for leaving the chat: ok
%
reaction(out(leave(Name)),(
        in_r(leave(Name)),
	in_r(user(Name,_)))).


% ----------------------------------------------------
% Added on-the-fly: #1
%
% notifying a new agent joining 
% or an agent leaving event
% to participants
%

reaction(inp(join(Name,UserTC)),(
	post,
        success, 
	current_time(T),
        out_r(user_list([])),
	out_r(multicast(god,['a new agent joined the chat: ',Name,' at ',T],T)))).


%
% reaction #3 B
%
reaction(out(leave(Name)),(
	current_time(T),
        out_r(user_list([])),
	out_r(multicast(god,['an agent left the chat: ',Name,' at ',T],T)))).

%
% to fix coord problem (case #a in the private note of aricci)
% 
% the multicast have been changed in order to signal
% when it finished (with a new tuple in the space)
%
reaction(out_r(multicast_end(Who,Msg,When)),(
	in_r(multicast_end(Who,Msg,When)))).

%
% to fix coord problem: leave(Agent) tuple left on the space
% because of interaction bewteen reaction #2 and the new reaction #3 B
%
reaction(out_r(multicast_end(Who,['an agent left the chat: ',Name,' at ',T],W)),(
	in_r(user(Name,_)))).
	
	
