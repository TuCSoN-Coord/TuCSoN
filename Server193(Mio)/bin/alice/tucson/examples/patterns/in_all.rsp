%
% Specifica della in_all
%
% si usa con:  inp(in_all(+Tuple,-List))
% 
% IPOTESI:  +Tuple non è una Variabile direttamente
% (ovvero non funziona con in_all(X,L) )
%
reaction(inp(in_all(T,L)),(
	pre,
	out_r(collect(T,[])))).

reaction(out_r(collect(T,L)),(
	current_tuple(collect(T1,_)),
	in_r(T1),
	in_r(collect(T,L)),
	out_r(collect(T,[T1|L])))).

reaction(out_r(collect(T,_)),(
	current_tuple(collect(T1,_)),
	no_r(T1),
	in_r(collect(T,L)),
	out_r(in_all(T,L)))).
