

% queue policy for request
% in(msg(SpecId,...))
% and also out

reaction(out(msg(X)),(
        in_r(msg(X)),
        %
        rd_r(in_queue(_,_,_)),
        %
        in_r(in_queue(Index,AgentId,X)),
        out_r(msg(AgentId,X)),
        %
        in_r(in_queue_head(Index)),
        Index1 is Index + 1,
        out_r(in_queue_head(Index1)))).

reaction(out(msg(X)),(
        in_r(msg(X)),
        %
        no_r(in_queue(_,_,_)),
        %
        in_r(out_queue_tail(Index)),
        Index1 is Index + 1,
        out_r(out_queue_tail(Index1)),
        %
        out_r(out_queue(Index,X)))).


reaction(in(msg(Id,X)),(
        pre,
        %
        no_r(out_queue(_,_)),
        %
        in_r(in_queue_tail(Index)),
        Index1 is Index + 1,
        out_r(in_queue_tail(Index1)),
        %
        out_r(in_queue(Index,Id,X)))).

reaction(in(msg(Id,X)),(
        pre,
        %
        rd_r(out_queue(_,_)),
        %
        in_r(out_queue_head(Index)),
        Index1 is Index + 1,
        out_r(out_queue_head(Index1)),
        %
        in_r(out_queue(Index,Y)),
        out_r(msg(Id,Y)))).







