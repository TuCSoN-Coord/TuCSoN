    reaction(out(request(_,_,_)),(
        rd_r(workers_available(N)),
        N>0)).

    reaction(out(request(Name,Data,From)),(
        rd_r(workers_available(N)),
        N == 0,
        in_r(tail(T)),
        T1 is T + 1,
        out_r(tail(T1)),
        in_r(request(Name,Data,From)),
        out_r(req_queue(T1,Name,Data,From)))).

    reaction(in(request(Name,Data,From)),(
        pre,
        rd_r(head(H)),
        rd_r(tail(T)),
        T < H)).

    reaction(in(request(Name,Data,From)),(
        pre,
        in_r(head(H)),
        rd_r(tail(T)),
        T >= H,
        H1 is H + 1,
        out_r(head(H1)),
        in_r(req_queue(H,N1,D1,F1)),
        out_r(request(N1,D1,F1)))).

    reaction(in(request(_,_,_)),(
        pre,
        in_r(workers_available(N)),
        N1 is N + 1,
        out_r(workers_available(N1)))).

    reaction(in(request(_,_,_)),(
        post,
        in_r(workers_available(N)),
        N1 is N - 1,
        out_r(workers_available(N1)))).

