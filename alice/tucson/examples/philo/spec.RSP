%
% specification used to coordinate philosophers
%

% protocols:
%   to acquire the chopsticks:  in(chops(+C1,+C2))
%   to release the chopsticks:  out(chops(+C1,+C2))
%


reaction(in(chops(C1,C2)), (
        pre,
        out_r(required(C1,C2)))).

reaction(in(chops(C1,C2)), (
        post,in_r(required(C1,C2)))).

reaction(out_r(required(C1,C2)),(
        in_r(chop(C1)),
        in_r(chop(C2)),
        out_r(chops(C1,C2)))).

reaction(out(chops(C1,C2)), (
        in_r(chops(C1,C2)),
        out_r(chop(C1)),
        out_r(chop(C2)))).

reaction(out_r(chop(C1)), (
        rd_r(required(C1,C)),
        in_r(chop(C1)),
        in_r(chop(C)),
        out_r(chops(C1,C)))).

reaction(out_r(chop(C2)), (
        rd_r(required(C,C2)),
        in_r(chop(C)),
        in_r(chop(C2)),
        out_r(chops(C,C2)))).


