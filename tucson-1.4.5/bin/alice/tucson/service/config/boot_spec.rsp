

reaction(out(boot),(
    in_r(boot),
    no_r(boot_info(_)),
    current_time(Time),
    out_r(boot_info([time(Time)])),
    %
    out_r(context_id(0)),
    out_r(authorised_agent(_)),
    %
    out_r(role(default,'default role')),
    %
    out_r(policy(default,'default policy')),
    %
    out_r(role_policy(default,default)),
    %
    out_r(role_assignment(_,_)))).


%
% context acquire
%
reaction( inp(context_request(AgentId,_)),(
  pre,
  no_r(authorised_agent(AgentId)),
  out_r(context_request(AgentId,failed(agent_not_authorised))))).

reaction( inp(context_request(AgentId,_)),(
  pre,
  rd_r(open_session(_,AgentId)),
  no_r(context_request(AgentId,ok(_))),
  out_r(context_request(AgentId,failed(agent_already_present))) )).
  
reaction( inp(context_request(AgentId,_)),(
  pre,
  rd_r(authorised_agent(AgentId)),
  in_r(context_id(Id)),
  Id1 is Id + 1,
  out_r(context_id(Id1)),
  no_r(open_session(_,AgentId,_)),
  out_r(open_session(Id,AgentId,[])),
  out_r(context_request(AgentId,ok(Id))) )).

%
% context release
%  
reaction( inp(context_shutdown(CtxId,AgentId,_)),(
  pre,
  rd_r(open_session(CtxId,AgentId,_)),
  out_r(context_shutdown(CtxId,AgentId,ok)) )).

reaction( inp(context_shutdown(CtxId,AgentId,ok)),(
  post,
  in_r(open_session(CtxId,AgentId,_)) )).

reaction( inp(context_shutdown(CtxId,AgentId,_)),(
  pre,
  no_r(open_session(CtxId,AgentId,_)),
  out_r(context_shutdown(CtxId,AgentId,failed(no_valid_context))) )).
  
%
% role activation
%  
reaction( inp(role_activation_request(CtxId,RoleId,Result)),(
  pre,
  in_r(open_session(CtxId,AgentId,RoleList)),
  rd_r(role(RoleId,Descr)),
  rd_r(role_assignment(RoleId,AgentId)),
  %
  out_r(open_session(CtxId,AgentId,[RoleId|RoleList])),
  rd_r(role_policy(RoleId,PolicyId)),
  rd_r(policy(PolicyId,Policy)),
  %
  out_r( role_activation_request(CtxId,RoleId,ok(Policy))))).




%
% command management
%

reaction(in(cmd(X)),(
  post,
  out_r(cmd_pending(X)))).
  
reaction(in(cmd_result(X,_)),(
  pre,
  no_r(cmd_result(X,_)),
  no_r(cmd_pending(X)),
  out_r(cmd_result(X,unknown)))).
  
reaction(in(cmd_result(X,R)),(
  pre,
  rd_r(cmd_pending(X)),
  out_r(cmd_result(X,pending)))).

reaction(out(cmd_result(X,R)),(
  no_r(cmd_pending(X)),
  in_r(cmd_result(X,R)))).
 
reaction(out(cmd_result(X,R)),(
  in_r(cmd_pending(X)) )).
      
%
% for persistency management
%
reaction(rdp(is_persistent(TC,R)),(  
  no_r(is_persistent(TC)),
  out_r(is_persistent(TC,false)))).
  
reaction(rd(is_persistent(TC,R)),(  
  pre,no_r(is_persistent(TC)),
  out_r(is_persistent(TC,false)))).
  
reaction(inp(in_persistent(TC,R)),(  
  no_r(is_persistent(TC)),
  out_r(is_persistent(TC,false)))).

reaction(in(is_persistent(TC,R)),(  
  pre, no_r(is_persistent(TC)),
  out_r(is_persistent(TC,false)))).

%

reaction(inp(is_persistent(TC,R)),(
  pre,  
  rd_r(is_persistent(TC)),
  R = true,
  out_r(is_persistent(TC,true)) )).

reaction(in(is_persistent(TC,R)),( 
  pre, 
  rd_r(is_persistent(TC)),
  R = true,
  out_r(is_persistent(TC,true)) )).

reaction(rdp(is_persistent(TC,R)),(
  pre,  
  rd_r(is_persistent(TC)),
  R = true,
  out_r(is_persistent(TC,true)) )).

reaction(rd(is_persistent(TC,R)),( 
  pre, 
  rd_r(is_persistent(TC)),
  R = true,
  out_r(is_persistent(TC,true)) )).
  