reaction(out(boot),(
	out_r(agent_list([])),
	out_r(tc_list([])),
	in_r(boot))).

%
%
		
reaction(out(node_event(N,new_tc(Tid))),(
	in_r(tc_list(L)),
	out_r(tc_list([Tid|L])))).

%
%

reaction(out(node_event(N,new_agent(Id))),(
	in_r(agent_list(L)),
	out_r(agent_list([Id|L])) )).
    
%

reaction(out(node_event(N,exit_agent(Id))),(
	in_r(agent_list(L)),
	out_r(agent_to_remove(Id,L,[])) )).

reaction(out_r(agent_to_remove(X,Y,Z)),(
    in_r(agent_to_remove(X,Y,Z)) )).
    
reaction(out_r(agent_to_remove(Id,[Id|L],L1)),(
    out_r(agent_to_remove(Id,L,L1)) )).
    
reaction(out_r(agent_to_remove(Id,[Id1|L],L1)),(
    Id1 \= Id,
    out_r(agent_to_remove(Id,L,[Id1|L1])) )).
	  
reaction(out_r(agent_to_remove(Id,[],L)),(
    out_r(agent_list(L)) )).
	  
	  