
reaction(out(line(X0,Y0,X1,Y1)),true,(
    in(line(X0,Y0,X1,Y1)),
    out(collecting),
    out(check_subscribers(line(X0,Y0,X1,Y1))))).

%

reaction(out(check_subscribers(Info)),endo,(
    rd(collecting),
    in(subscription(Template,Dest)),
    out(bak(subscription(Template,Dest))),
    out(match(Info,Template,Dest)),
    out(check_subscribers(Info)))).

reaction(out(check_subscribers(_)),endo,(
    no(subscription(_,_)),
    in(collecting),
    out(restore_subscribers))).

reaction(out(check_subscribers(_)),endo,(
    in(check_subscribers(_)))).

%

reaction(out(match(Info,Template,Dest)),endo,(
    current_tuple(match(X,X,_)),
    Dest ? Info)).

reaction(out(match(_,_,_)),endo,(
    in(match(_,_,_)))).

% 

reaction(out_r(restore_subscribers),endo,(
    in(bak(subscription(Template,Dest))),
    out(subscription(Template,Dest)),
    out(restore_subscribers))).

reaction(out(restore_subscribers),endo,(
    in(restore_subscribers))).



