

reaction(out(channel(Info)),(
    in_r(request))).
    
reaction(out(channel(Info)),(
    no_r(request),
    in_r(channel(Info)),
    in_r(queue(T,H)),
    T1 is T + 1,
    out_r(queue(T1,H)),
    current_time(Time),
    out_r(queue_elements(T1,info(Info,Time))))).
    
reaction(in(channel(_)),(
    pre,
    rd_r(queue(X,X)),
    out_r(request))).
    
reaction(in(channel(_)),(
    pre,
    in_r(queue(T,H)),
    T > H,
    H1 is H + 1,
    out_r(queue(T,H1)),
    in_r(queue_elements(H1,Info)),
    out_r(channel(Info)))).
    
