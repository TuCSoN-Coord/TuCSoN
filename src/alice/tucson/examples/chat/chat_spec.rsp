% -----------------------------------------------


%
% sending msgs
%

%
% if a registered user sends a msg,
% accept and broadcast the msg
%
reaction(
			out(msg(Name,Msg)),
			(
				endo
			),
			(
    			in(msg(Name,Msg)),
        		rd(user(Name,_)),
        		out(user_list([])),
        		current_time(T),
    			out(multicast(Name,Msg,T))
    		)
    	).

%
% generate a msg for each registered user
%

reaction(
			out(multicast(Who,Msg,When)),
			(
				endo
			),
			(
    			in(multicast(Who,Msg,When)),
        		in(user(Name,TupleCentre)),
        		in(user_list(L)),
        		out(user_list([user(Name,TupleCentre)|L])),
        		TupleCentre ? out(msg(Who,Msg,When)),
        		out(multicast(Who,Msg,When))
        	)
        ).

reaction(
			out(multicast(Who,Msg,When)),
			(
				endo
			),
			(
    			in(multicast(Who,Msg,When)),
    			no(user(_,_)),
    			in(user_list(L)),
    			out(out_list(L))
    		)
    	).

%-----------------------------------------------------------------------------

%
% helper reactions
%

reaction(
			out(out_list([])),
			(
				endo
			),
			(
	    		in(out_list([]))
	    	)
    	).

reaction(
			out(out_list([X|Rest])),
			(
				endo
			),
			(
    			in(out_list([X|Rest])),
    			out(X),
    			out(out_list(Rest))
    		)
    	).
