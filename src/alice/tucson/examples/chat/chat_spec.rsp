%
% to join:      inp(join(+Name,+MyTupleCentre))
% to leave:     out(leave(+Name))
% to send msg:  out(msg(+Name,+Msg))
% to read msg:  MyTupleCentre ? in(msg(Who,What,When))

%
% joining the chat room
%

%
% accept a new user only if 
% no other user are registered with the same Name
%
reaction(
			inp(join(Name,UserTC)),
				request,
	        (
	        	no(user(Name,_)),
	        	out(user(Name,UserTC)),
	        	out(join(Name,UserTC))
	        )
        ).

%
% leaving the chat room
%

%
% reaction #2
%
% a registered user ask for leaving the chat: ok
%

reaction(
			out(leave(Name)),
			(
    			in(leave(Name)),
    			in(user(Name,_))
    		)
    	).

% ----------------------------------------------------
% Added on-the-fly: #1
%
% notifying a new agent joining 
% or an agent leaving event
% to participants
%

 reaction(
 			inp(join(Name,UserTC)),
 			(
    			response,
    			success
    		),
    		( 
    			current_time(T),
    			out(user_list([])),
    			out(multicast(god,['a new agent joined the chat: ',Name,' at ',T],T))
    		)
    	).


%
% reaction #3 B
%
 reaction(
 			in(leave(Name)),
 			(
 				endo
 			),
 			(
    			current_time(T),
    			out(user_list([])),
    			out(multicast(god,['an agent left the chat: ',Name,' at ',T],T))
    		)
    	).

